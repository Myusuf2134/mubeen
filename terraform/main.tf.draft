# MB-020 Infrastructure as Code (Terraform) — DRAFT SCAFFOLD ONLY
# This is a learning exercise for SRE/cloud infrastructure.
# DO NOT run terraform init/plan/apply; fill in TODO sections.

# TODO: Configure Terraform backend
#   - Local state for learning, or S3 backend for production?
#   - Decide based on deployment target (local dev vs AWS account)

terraform {
  required_version = ">= 1.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"  # TODO: Pin to specific version or version constraint
    }
  }

  # TODO: Uncomment and configure for shared state (learning: understand backend tradeoffs)
  # backend "s3" {
  #   bucket         = "TODO-terraform-state-bucket"
  #   key            = "mubeen/terraform.tfstate"
  #   region         = "us-east-1"
  #   encrypt        = true
  # }
}

provider "aws" {
  region = var.aws_region
  # TODO: Add tags for all resources (standard practice for cost allocation, automation)
  default_tags {
    tags = {
      Project     = "Mubeen"
      Environment = var.environment
      ManagedBy   = "Terraform"
    }
  }
}

