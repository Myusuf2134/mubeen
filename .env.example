# ── Database ────────────────────────────────────────────────────────────────
# Async URL used by the FastAPI app at runtime
DATABASE_URL=postgresql+asyncpg://mubeen:mubeen@localhost:5432/mubeen
# Sync URL used by Alembic for migrations
DATABASE_URL_SYNC=postgresql://mubeen:mubeen@localhost:5432/mubeen

# ── Security ─────────────────────────────────────────────────────────────────
# Required in ALL environments — no default exists. The app will refuse to start
# if this is empty. Non-development environments also require ≥ 32 characters.
# Generate a strong value: openssl rand -hex 32
SECRET_KEY=

# ── External APIs ─────────────────────────────────────────────────────────────
# Never commit real keys — fill these in your local .env
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON list of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]
